# Runtime
NODE_ENV=development
API_PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
LOG_LEVEL=info
CLINIC_TIMEZONE=Asia/Kolkata

# Supabase PostgreSQL + Prisma
# Persistent Node runtime: Supavisor session mode normally uses port 5432.
DATABASE_URL=postgresql://prisma.PROJECT_REF:replace-me@REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection for migrations and administrative operations.
DIRECT_URL=postgresql://prisma:replace-me@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Authentication and sessions
# Supported modes: otp; password is the documented day-1 fallback only.
AUTH_MODE=otp
# HS256 JWT signing secret. Use at least 32 random bytes.
SESSION_SECRET=replace-me-with-at-least-32-random-bytes
SESSION_JWT_ISSUER=clinic-scheduler-api
SESSION_JWT_AUDIENCE=clinic-scheduler-web
OTP_HMAC_SECRET=replace-me-with-a-separate-32-byte-secret
SESSION_COOKIE_NAME=clinic_session
SESSION_TTL_SECONDS=86400
# Must be true outside local HTTP development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# OTP policy
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900
DEMO_AUTH_ENABLED=false
DEMO_OTP_CODE=123456

# Seeded manager
SEED_MANAGER_EMAIL=manager@clinic.test
SEED_MANAGER_NAME=Clinic Manager

# Mailtrap Email API
MAILTRAP_API_KEY=replace-me
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=replace-me
MAIL_FROM_EMAIL=no-reply@clinic.test
MAIL_FROM_NAME=Clinic Scheduler

# Bootstrap and import safety
RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true
IMPORT_MAX_FILE_BYTES=2097152
IMPORT_MAX_ROWS=10000

# SSE
SSE_HEARTBEAT_INTERVAL_MS=15000
SSE_RETRY_INTERVAL_MS=3000
