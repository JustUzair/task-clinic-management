    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "7.0.1",
    "dotenv": "17.3.1",
    "express": "4.21.2",
    "helmet": "8.3.0",
    "jose": "6.2.3",
    "luxon": "3.7.2",
    "multer": "2.1.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
